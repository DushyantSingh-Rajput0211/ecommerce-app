# Storefront environment variables — copy to .env.local and fill in real values.
# None of these are secrets that must stay server-side (all are NEXT_PUBLIC_,
# i.e. exposed to the browser). Never put a Stripe SECRET key or DB URL here.

# Medusa backend (falls back to localhost in dev)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# Stripe — PUBLISHABLE key only (safe for the client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Demo admin gate (local-first only — replace with real auth before production)
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# Canonical site URL (used for metadata, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
